{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-forge.local/schemas/normalized-unit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "document_id", "ordinal", "heading", "text", "content_sha256"],
  "properties": {
    "unit_id": {"type": "string", "pattern": "^unit-[0-9a-f]{20}$"},
    "document_id": {"type": "string", "pattern": "^doc-[0-9a-f]{20}$"},
    "ordinal": {"type": "integer", "minimum": 0},
    "heading": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
