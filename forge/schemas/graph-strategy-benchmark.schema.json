{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-forge.local/schemas/graph-strategy-benchmark.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "export_sha256",
    "index_sha256",
    "suite_sha256",
    "max_chars",
    "repeat_count",
    "minimum_repeat_count",
    "cases",
    "metrics",
    "selection_projection",
    "timing_projection",
    "decision",
    "decision_reasons",
    "benchmark_sha256"
  ],
  "properties": {
    "format_version": {"const": 1},
    "kind": {"const": "portable-graph-strategy-benchmark"},
    "export_sha256": {"$ref": "#/$defs/sha256"},
    "index_sha256": {"$ref": "#/$defs/sha256"},
    "suite_sha256": {"$ref": "#/$defs/sha256"},
    "max_chars": {"type": "integer", "minimum": 1, "maximum": 100000},
    "repeat_count": {"type": "integer", "minimum": 1},
    "minimum_repeat_count": {"const": 3},
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/caseResult"}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline-depth-1", "lexical-v1"],
      "properties": {
        "baseline-depth-1": {"$ref": "#/$defs/strategyMetrics"},
        "lexical-v1": {"$ref": "#/$defs/strategyMetrics"}
      }
    },
    "selection_projection": {"$ref": "#/$defs/selectionProjection"},
    "timing_projection": {"$ref": "#/$defs/timingProjection"},
    "decision": {"enum": ["promote", "do-not-promote", "inconclusive"]},
    "decision_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "benchmark_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "areaIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "area_id", "module_ids", "alternatives"],
      "properties": {
        "status": {"enum": ["covered", "not-covered", "ambiguous"]},
        "area_id": {
          "oneOf": [
            {"$ref": "#/$defs/areaIdentifier"},
            {"type": "null"}
          ]
        },
        "module_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "alternatives": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/areaIdentifier"}
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "percent"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "percent": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "strategyMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_coverage",
        "area_coverage",
        "negative_rejection",
        "ambiguity_fail_closed",
        "integrity",
        "median_admitted_chars"
      ],
      "properties": {
        "primary_coverage": {"$ref": "#/$defs/metric"},
        "area_coverage": {"$ref": "#/$defs/metric"},
        "negative_rejection": {"$ref": "#/$defs/metric"},
        "ambiguity_fail_closed": {"$ref": "#/$defs/metric"},
        "integrity": {"$ref": "#/$defs/metric"},
        "median_admitted_chars": {"type": "integer", "minimum": 0}
      }
    },
    "strategyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "actual",
        "context_trace",
        "selection_sha256",
        "integrity"
      ],
      "properties": {
        "strategy_id": {"enum": ["baseline-depth-1", "lexical-v1"]},
        "actual": {"$ref": "#/$defs/route"},
        "context_trace": {
          "$ref": "https://knowledge-forge.local/schemas/context-trace.schema.json"
        },
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "integrity": {"type": "boolean"}
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "category", "expected", "strategies"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "category": {
          "enum": ["canonical", "paraphrase", "negative", "ambiguous"]
        },
        "expected": {"$ref": "#/$defs/route"},
        "strategies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/strategyResult"}
        }
      }
    },
    "selectionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "selection_sha256"],
      "properties": {
        "cases": {"type": "array"},
        "selection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "timingProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_ids", "samples_ns", "summary_ns"],
      "properties": {
        "strategy_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"enum": ["baseline-depth-1", "lexical-v1"]}
        },
        "samples_ns": {"type": "object"},
        "summary_ns": {"type": "object"}
      }
    }
  }
}
