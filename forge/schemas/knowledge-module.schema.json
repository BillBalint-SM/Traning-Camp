{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-forge.local/schemas/knowledge-module.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "maturity",
    "confidence",
    "language",
    "tags",
    "aliases",
    "relations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "principle",
        "concept",
        "pattern",
        "decision-guide",
        "failure-mode",
        "procedure",
        "checklist",
        "experiment"
      ]
    },
    "maturity": {
      "type": "string",
      "enum": ["candidate", "reviewed", "validated", "deprecated"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "language": {
      "const": "hu"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "depends_on",
              "supports",
              "contrasts_with",
              "prevents",
              "applies_to",
              "validated_by"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
          }
        }
      }
    }
  }
}
